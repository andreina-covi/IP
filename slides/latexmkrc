# slides/latexmkrc — used when the editor / latexmk runs with cwd = slides/
$ENV{'TZ'} = 'Europe/Prague';

use Cwd 'abs_path';

my $root = abs_path('..');
ensure_path('TEXINPUTS', $root);
ensure_path('TEXINPUTS', "$root/common//");
ensure_path('TEXINPUTS', "$root/fibeamer//");
ensure_path('TEXINPUTS', "$root/resources//");

# Required by minted (Pygments)
set_tex_cmds('-shell-escape %O %S');
