\begin{Verbatim}[commandchars=\\\{\}]
            \PYG{c+c1}{\PYGZsh{} estructura[fila][columna]  →  estructura[i][j]}
            \PYG{n}{matriz} \PYG{o}{=} \PYG{p}{[[}\PYG{l+m+mi}{10}\PYG{p}{,} \PYG{l+m+mi}{20}\PYG{p}{,} \PYG{l+m+mi}{30}\PYG{p}{],}
                      \PYG{p}{[}\PYG{l+m+mi}{40}\PYG{p}{,} \PYG{l+m+mi}{50}\PYG{p}{,} \PYG{l+m+mi}{60}\PYG{p}{],}
                      \PYG{p}{[}\PYG{l+m+mi}{70}\PYG{p}{,} \PYG{l+m+mi}{80}\PYG{p}{,} \PYG{l+m+mi}{90}\PYG{p}{]]}
            \PYG{c+c1}{\PYGZsh{} ¿Cómo se lee?  matriz[i][j]}
            \PYG{c+c1}{\PYGZsh{}   i → elige la lista interna (la fila)}
            \PYG{c+c1}{\PYGZsh{}   j → elige el elemento dentro de esa lista}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{matriz}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{])}      \PYG{c+c1}{\PYGZsh{} [40, 50, 60]  ← toda la fila 1}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{matriz}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{][}\PYG{l+m+mi}{2}\PYG{p}{])}   \PYG{c+c1}{\PYGZsh{} 60 ← fila 1, columna 2}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{matriz}\PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{][}\PYG{l+m+mi}{0}\PYG{p}{])}  \PYG{c+c1}{\PYGZsh{} 70 ← última fila, primer elemento}
\end{Verbatim}
