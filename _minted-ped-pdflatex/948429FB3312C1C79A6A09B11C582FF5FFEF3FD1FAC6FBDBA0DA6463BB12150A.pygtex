\begin{Verbatim}[commandchars=\\\{\}]
            \PYG{n}{puntos} \PYG{o}{=} \PYG{p}{[(}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{),} \PYG{p}{(}\PYG{l+m+mi}{3}\PYG{p}{,} \PYG{l+m+mi}{4}\PYG{p}{),} \PYG{p}{(}\PYG{l+m+mi}{5}\PYG{p}{,} \PYG{l+m+mi}{6}\PYG{p}{)]}

            \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{puntos}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{])}      \PYG{c+c1}{\PYGZsh{} (1, 2)   ← la primera tupla completa}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{puntos}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{][}\PYG{l+m+mi}{0}\PYG{p}{])}  \PYG{c+c1}{\PYGZsh{} 3        ← segundo punto, coordenada x}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{puntos}\PYG{p}{[}\PYG{l+m+mi}{2}\PYG{p}{][}\PYG{l+m+mi}{1}\PYG{p}{])}  \PYG{c+c1}{\PYGZsh{} 6        ← tercer punto, coordenada y}
\end{Verbatim}
